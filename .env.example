# ---------------------------------------------------------------------------
# Everything here is optional. With no env file at all the admin runs on a
# local store (.data/db.json + .data/uploads) and is fully usable.
# Add the three Supabase values and the same UI switches to Supabase.
# ---------------------------------------------------------------------------

# Signs the admin session cookie. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# If omitted, a secret is generated once and kept in .data/session-secret.
SESSION_SECRET=

# --- Supabase (leave blank to stay on the local store) ---------------------
# Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Server only. Never expose this to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Created by supabase/schema.sql
SUPABASE_STORAGE_BUCKET=blog-media

# --- Local-mode admin credentials -----------------------------------------
# Used only while Supabase is not configured. Change these before deploying.
ADMIN_EMAIL=admin@studio.local
ADMIN_PASSWORD=studio1234

# --- Public site URL, used for canonical links, RSS and the sitemap --------
NEXT_PUBLIC_SITE_URL=http://localhost:3000