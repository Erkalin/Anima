# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# local blog store: database json + uploaded files
/.data

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# local session backups (pre-edit safety copies, not project source)
/.removed-playable-instruments/
/.hero-bg-backup/
/.plate-removal-backup/
/.cue-pending-backup/
/.duet-backup/
/.duet-photos-backup/

# local tooling / agent caches
/.claude/
/.kilo/
/.codex/
/.playwright-cli/
/.zcode/
/.qwen/
/.tmp/
/supabase/.temp/
/debug.log
